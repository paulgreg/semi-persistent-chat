{
    "name": "semi-persistent-chat",
    "version": "0.1.0",
    "main": "dist/server/index.js",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "type": "module",
    "scripts": {
        "analyze": "./node_modules/.bin/vite-bundle-visualizer",
        "dev:client": "vite",
        "dev:server": "DEBUG=chat tsx --watch --watch-path=src/server src/server/index.ts",
        "browserlist": "./node_modules/.bin/browserslist --update-db",
        "build": "npm run browserlist && npm run build:server && npm run build:client",
        "build:server": "NODE_ENV=production vite build --outDir dist/server --ssr ./src/server/index.ts",
        "build:client": "NODE_ENV=production vite build --outDir dist/client",
        "start": "NODE_ENV=production node dist/server/index.js",
        "test": "vitest --run",
        "tdd": "vitest",
        "lint": "eslint src",
        "format": "prettier -c src",
        "format:fix": "prettier -c src --write"
    },
    "pre-commit": [
        "format",
        "lint",
        "test"
    ],
    "dependencies": {
        "@emoji-mart/data": "^1.2.1",
        "@emoji-mart/react": "^1.1.1",
        "charset": "^1.0.1",
        "cheerio": "^1.2.0",
        "debug": "^4.4.3",
        "dotenv": "^18.0.9",
        "emoji-mart": "^5.6.0",
        "express": "^5.3.0",
        "iconv-lite": "^0.7.3",
        "jschardet": "^4.0.0",
        "linkify-react": "^4.4.0",
        "lru-cache": "^11.5.3",
        "morgan": "^1.12.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-favicon": "^2.0.7",
        "redis": "^6.3.0",
        "smile2emoji": "^3.20.2",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "tsx": "^4.23.15",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/react": "^16.3.3",
        "@types/charset": "^1.0.5",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-linkify": "^1.0.4",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "nodemon": "^3.1.14",
        "pre-commit": "^2.0.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vite-bundle-visualizer": "^1.2.1",
        "vite-plugin-eslint": "^1.8.1",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "@emoji-mart/react": {
            "react": "19",
            "react-dom": "19"
        }
    }
}
